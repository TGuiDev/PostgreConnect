# Servidor
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Banco de metadados (guarda as conexoes cadastradas). Pode ser um Postgres
# dedicado, criado no proprio Dokploy.
METADATA_DATABASE_URL=postgres://user:password@metadata-db:5432/postgreconnect

# Chave de 32 bytes em hex (64 caracteres) usada para criptografar as senhas
# dos bancos cadastrados. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Lista de API keys validas, separadas por virgula. Gere cada uma com:
# openssl rand -hex 32
API_KEYS=

# Rate limit (requests por janela, por IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Timeout de query (ms) aplicado via statement_timeout nas conexoes de destino
QUERY_TIMEOUT_MS=15000

# Tempo (ms) que um pool de conexao fica ocioso antes de ser fechado
POOL_IDLE_EVICT_MS=600000

# Numero maximo de conexoes simultaneas por banco cadastrado
POOL_MAX_CONNECTIONS=5
